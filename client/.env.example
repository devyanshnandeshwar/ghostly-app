# The API is a separate origin in production (Render), so these are absolute
# URLs rather than same-origin paths. Set them in the Vercel dashboard.

# Versioned prefix is the contract. /api without a version is a compatibility
# alias for clients cached before versioning existed.
VITE_API_URL=http://localhost:5000/api/v1

# Socket.IO endpoint. Empty falls back to window.location.origin, which is only
# correct when the API is same-origin -- it is not in the split deployment.
VITE_SOCKET_URL=http://localhost:5000
