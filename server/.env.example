PORT=5000
MONGO_URI=mongodb://localhost:27017/kylmo
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Signs session tokens. MUST be a strong random value in production
# (the server refuses to boot with the default) — openssl rand -hex 32
SESSION_SECRET=supersecret_change_me
# Minimum AI confidence (0-1) required to mark a session verified
MIN_VERIFY_CONFIDENCE=0.85
# Bearer token for /api/admin/* — generate with: openssl rand -hex 32
# Leave unset to disable the admin API entirely.
ADMIN_TOKEN=
