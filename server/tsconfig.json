{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "./dist",
    // Explicit, and deliberately the monorepo root: the emitted layout must stay
    // dist/server/src/... and dist/shared/src/... because the Dockerfile CMD and
    // the @shared module alias in package.json both point at those paths.
    "rootDir": "..",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    // No baseUrl: it is deprecated in TS 7. Without it, "paths" resolve
    // relative to this file's directory, which gives the same result here.
    "paths": {
      "@shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*", "../shared/src/**/*"]
}