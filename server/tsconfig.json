{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "./dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    // "bun" supplies the bun:test module declarations for *.test.ts. It sits
    // alongside "node" rather than replacing it: the server runs on Bun but the
    // source is written against Node's stdlib types.
    "types": [
      "node",
      "bun"
    ]
  },
  "include": ["src/**/*"]
}