# Local development. In production these are set in the Render dashboard
# (see render.yaml for which are secrets and which are generated).

PORT=5000
NODE_ENV=development

# Local Docker (docker compose up -d) or a MongoDB Atlas connection string.
MONGO_URI=mongodb://localhost:27017/ghostly

# Local Docker or an Upstash endpoint. Use rediss:// for Upstash (TLS).
#
# Redis holds only what must survive a restart: the filter quota, the
# socket-connect limiter, the HTTP limiters and the lastActive throttle. The
# queue, presence and session cache are in-process, so ordinary chat traffic
# costs no Redis commands at all.
REDIS_URL=redis://localhost:6379

# Comma-separated list of origins allowed to call this API.
#
# The SPA is served from a different origin in production, so this is
# load-bearing rather than incidental: a missing origin does not degrade, the
# socket handshake is simply refused. List every origin the app is reachable
# on -- the platform domain AND any custom domain.
CLIENT_URL=http://localhost:5173

# Signs session tokens. MUST be a strong random value in production; the server
# refuses to boot with the default. Generate with: openssl rand -hex 32
#
# Rotating this signs out every user at once. Per-session revocation exists for
# the normal case: POST /api/v1/session/logout bumps that session's token
# version and leaves everyone else alone.
SESSION_SECRET=supersecret_change_me

# Bearer token for /api/v1/admin/*. Unset leaves those routes returning 503.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Floor on the confidence a client reports with its gender claim (0-1).
# Advisory only: classification happens in the browser, so a client can send
# any number. It still stops an honest client's uncertain prediction from
# verifying.
MIN_VERIFY_CONFIDENCE=0.85

# Days to keep abuse reports before a TTL index expires them. 0 keeps forever.
REPORT_RETENTION_DAYS=365

# Only needed off Render/Cloudflare. Client IP resolution prefers
# CF-Connecting-IP, which cannot be forged; this is the hop count for the
# X-Forwarded-For fallback used elsewhere.
# TRUSTED_PROXY_HOPS=1
